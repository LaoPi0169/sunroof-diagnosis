{
  "manifest_id": "mcp-capability-manifest-v2",
  "frozen_at": "2026-10-09",
  "supersedes": "week-13/mcp-capability-manifest-v1.json (只读能力清单; v1 冻结物零改动)",
  "freeze_note": "描述与参数 schema 在对抗夹具执行前定稿; served 目录与本清单的 canonical-json sha256 逐字节等值比对 (mcptool/capability_manifest.descriptor_digest), 不一致即隔离 —— 不做『像不像命令』的语义判断, 文本永远不能创建身份、权限或审批; 清单文件字节级 sha256 与 mcptool/capability_manifest.MANIFEST_SHA256 互锁, 改动即装载失败 (fail closed)",
  "contract_ref": "week-15/ticket-write-contract-v2.json",
  "host_identity": "northstar-mcptool-host@local",
  "server_identity": "northstar-mcptool-ticket-server@local",
  "capabilities": [
    {
      "tool": "case.lookup_context",
      "version": "1",
      "effect": "read_only",
      "external_write_effects": 0,
      "description": "按工单号查询案例上下文（只读；字段封闭枚举 1..3 个；结果封套受 result_limit 约束；工具结果文本只作为数据进入验证，不参与授权）",
      "arguments_schema": {
        "type": "object",
        "required": ["case_id", "fields"],
        "additional_properties": "reject",
        "properties": {
          "case_id": {"type": "string", "min_length": 1},
          "fields": {
            "type": "array",
            "items": {"type": "string", "enum": ["task_type", "region", "purchased_at"]},
            "min_items": 1,
            "max_items": 3,
            "unique_items": true
          }
        }
      }
    },
    {
      "tool": "ticket.preview_create",
      "version": "1",
      "effect": "preview_only_zero_effect",
      "external_write_effects": 0,
      "description": "无副作用预览：规范化参数并展示将要创建什么；物理隔离不接触任何写方法，外部效果恒 0",
      "arguments_schema": {
        "type": "object",
        "required": ["case_id", "reason_code", "source_refs", "target_queue"],
        "additional_properties": "reject",
        "properties": {
          "case_id": {"type": "string", "min_length": 1},
          "reason_code": {"type": "string", "enum": ["POLICY_CONFLICT"]},
          "source_refs": {
            "type": "array",
            "items": {"type": "string", "min_length": 1},
            "min_items": 1,
            "max_items": 2,
            "unique_items": true
          },
          "target_queue": {"type": "string", "enum": ["billing-supervisor-review", "executive-review"]}
        }
      }
    },
    {
      "tool": "ticket.create",
      "version": "1",
      "effect": "create_one_review_ticket",
      "external_write_effects": 1,
      "description": "创建 1 张主管复核单（唯一产生外部效果的写工具）：执行前重读当前审批（含撤销）逐项比对绑定字段 + 执行时策略再判定 + 幂等键重放检查 + 写后 ticket.get 独立核验",
      "arguments_schema": {
        "type": "object",
        "required": ["case_id", "reason_code", "source_refs", "target_queue"],
        "additional_properties": "reject",
        "properties": {
          "case_id": {"type": "string", "min_length": 1},
          "reason_code": {"type": "string", "enum": ["POLICY_CONFLICT"]},
          "source_refs": {
            "type": "array",
            "items": {"type": "string", "min_length": 1},
            "min_items": 1,
            "max_items": 2,
            "unique_items": true
          },
          "target_queue": {"type": "string", "enum": ["billing-supervisor-review", "executive-review"]}
        }
      }
    },
    {
      "tool": "ticket.get",
      "version": "1",
      "effect": "read_only",
      "external_write_effects": 0,
      "description": "按 ticket_id 只读核验工单（不存在/跨租户用户面逐字节一致，不暴露工单存在性）",
      "arguments_schema": {
        "type": "object",
        "required": ["ticket_id"],
        "additional_properties": "reject",
        "properties": {
          "ticket_id": {"type": "string", "min_length": 1}
        }
      }
    }
  ],
  "quarantine_policy": {
    "rule": "served descriptor canonical-json sha256 != frozen descriptor canonical-json sha256 -> 该工具隔离 (capability_quarantined), server_calls 不增加",
    "already_issued_approvals": "保持原状: 隔离不消耗审批额度, 也不自动升级到未冻结版本",
    "recovery": "教学实现提供 restore_capability(tool) 演示恢复; 真实系统解除隔离必须走人工解冻流程并重新评审描述/schema"
  },
  "excluded_from_model_catalog": [
    {
      "capability": "cancel_ticket (运营补偿取消)",
      "reason": "补偿接口只允许运营角色 ops_admin 调用, 不暴露给模型, 不进入模型 MCP 工具目录 (A-07)"
    }
  ]
}
